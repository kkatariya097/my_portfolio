# Base URL for "content" assets (resume, profile photo) served from S3.
# Not secret — this is just the bucket's public URL. Copy this file to
# .env.local (gitignored) to point local dev at the real bucket, or leave
# unset to fall back to the local /public/assets copy (see src/lib/assets.ts).
NEXT_PUBLIC_ASSETS_URL=https://kavya-katariya-portfolio-assets.s3.us-east-1.amazonaws.com
